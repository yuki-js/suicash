# systemd unit that runs the FeliCa oracle (server crate) as a service on Debian.
# Install to: /etc/systemd/system/felica-oracle.service
#
# Prerequisites:
#   - Repository cloned to /opt/suicash (-b usb-poc)
#   - cargo build --release --manifest-path server/Cargo.toml --bin oracle already run
#   - Keys placed at /etc/felica-oracle/keys.json (mode 600) (never in the repository)
#
# Adjust paths/user to your environment.
[Unit]
Description=FeliCa IDi oracle (challenge/settle/attest)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=felica
WorkingDirectory=/opt/suicash
# Listen on 127.0.0.1 only (exposed via cloudflared; no ports opened directly)
Environment=FELICA_BIND_ADDR=127.0.0.1:3000
Environment=FELICA_PROVING_KEY_PATH=/opt/suicash/prover/assets/proving_key.bin
# Keys are read from a file (mode 600 secret). Don't inline the JSON in an env var.
Environment=FELICA_KEYS_JSON_FILE=/etc/felica-oracle/keys.json
ExecStart=/opt/suicash/server/target/release/oracle
Restart=always
RestartSec=3
# Proof generation takes ~500MB per run. Leave headroom (attest crashes if short)
# MemoryMax=2G

[Install]
WantedBy=multi-user.target
