<?xml version="1.0" encoding="utf-8"?>
<!--
  SuiCash UI Shell — minimal WebView shell that shows face-auth-ui (React) on a real Hi-CARA device.

  The device has no browser, so adb reverse exposes the PC's dev server (localhost:5173)
  as the device's localhost, and the WebView shows it full screen.

  The URL can be overridden via the intent data:
    adb shell am start -n jp.serkenn.hicara.suicashui/.MainActivity \
      -d "http://localhost:5173/?mode=enroll"
  With singleTask + onNewIntent, the same command switches screens even while running
  (first implementation of mode switching from the host CLI).

  http (cleartext) only talks to localhost, so it is allowed via usesCleartextTraffic=true.
  getUserMedia works because http://localhost counts as a secure context.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="jp.serkenn.hicara.suicashui"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:label="SuiCash UI"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
